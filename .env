# Configuración de Book Manager - Sprint 3

# API de cotizaciones del dólar (usada por el ServicioCotizacionDolar)
API_URL=https://dolarapi.com/v1/dolares

# Base de datos relacional del sistema
DATABASE_URL=sqlite:///book_manager.db

# Sitio objetivo del scraper
CUSPIDE_URL=https://cuspide.com

# Comportamiento del crawler Scrapy
SCRAPY_USER_AGENT=BookManager/3.0 (tp-integrador-sprint-3; +https://github.com/amarillaRodrigo/book_manager_g45)
SCRAPY_DELAY=1.0
SCRAPY_CONCURRENT_REQUESTS=4
SCRAPY_TIMEOUT=30
SCRAPY_RETRY_TIMES=3
SCRAPY_LOG_LEVEL=INFO
